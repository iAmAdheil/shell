# Google OAuth client (https://console.cloud.google.com/apis/credentials)
# Authorized JS origin:   http://localhost:5173
# Authorized redirect URI: http://localhost:8081/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Postgres (docker compose service "postgres", host port 5433)
DATABASE_URL=postgres://shell:shell@localhost:5433/shell?sslmode=disable

# OAuth callback base — must match the Authorized redirect URI above
APP_BASE_URL=http://localhost:8081
WEB_BASE_URL=http://localhost:5173

# Sentry (https://sentry.io) — leave SENTRY_DSN and VITE_SENTRY_DSN empty to
# turn error reporting off. The app runs either way.
#
# The two DSNs point at two Sentry projects: make one for the Go server and one
# for the browser. Sentry recommends that split for a frontend and a backend,
# even in one repo. It scopes an error to one side, keeps Go and JavaScript
# stack traces apart, and still joins both sides into one distributed trace.
#
# Both DSNs are safe to be public. A DSN only accepts new events. It grants no
# read access to anything already in Sentry.
#
# The server reads SENTRY_DSN when it starts. Vite writes VITE_SENTRY_DSN into
# the bundle when it builds, so a change to it needs a new `npm run build`.
SENTRY_DSN=
VITE_SENTRY_DSN=

SENTRY_ENVIRONMENT=development
VITE_SENTRY_ENVIRONMENT=development

# Share of requests that get a timing report, from 0.0 to 1.0. 1.0 shows every
# trace while you set this up. Lower it before you run this in production.
SENTRY_TRACES_SAMPLE_RATE=1.0
VITE_SENTRY_TRACES_SAMPLE_RATE=1.0

# Source map upload, so a browser stack trace names your own code instead of
# minified code. `npm run build` uploads only when all three are set.
# Make the token at https://sentry.io/settings/account/api/auth-tokens/ with
# the "project:releases" scope. It never reaches the browser.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
